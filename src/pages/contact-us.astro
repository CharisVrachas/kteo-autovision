---
/**
 * /contact-us/ — contact form, the two centres, and opening hours.
 *
 * `noFooter` hides the footer here: the page is a full-height contact panel and
 * the footer would repeat the same addresses immediately below it. The markup
 * still ships, because Barba needs the same shell on both sides of a transition.
 */
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
import FormFeedback from "../components/ui/FormFeedback.astro";
import { site, branches, openingHours } from "../data/site";
---

<Base
	title="Επικοινωνία — ΙΚΤΕΟ Autovision Ρόδου"
	description="Δύο σημεία τεχνικού ελέγχου στη Ρόδο: Ασγούρου και Τσαϊρι. Τηλ. 22410 03333 και 22410 67677, info@kteo-rodos.gr."
	namespace="contacts"
	pageLabel="Επικοινωνία"
	pageStyles={["contacts"]}
	navTheme="dark"
	noFooter
>
	<section data-theme-section="dark" class="section_contacts">
		<div class="container">
			<div class="padding is-none is-border-btn-none">
				<div class="contacts_wrap">
					<div class="content-grid is-cols-2">
						<div class="grid-col contacts_cell is-header">
							<h1 class="heading_h2">Επικοινωνία</h1>
						</div>
						<div class="grid-col contacts_cell is-header">
							<p class="heading_h5 contacts_lead">
								Επικοινωνήστε μαζί μας για οποιαδήποτε απορία — ή περάστε από ένα από τα δύο
								σημεία τεχνικού ελέγχου μας στη Ρόδο.
							</p>
						</div>

						<div class="grid-col contacts_cell">
							<div class="contacts_info">
								<a href={`mailto:${site.email}`} class="contacts_link heading_h5">{site.email}</a>
								{
									site.phones.map((phone) => (
										<a href={phone.href} class="contacts_link heading_h5">
											{phone.label}
										</a>
									))
								}
								<div class="contacts_socials">
									<a href={`mailto:${site.email}`} class="contacts_social" aria-label="Email">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 22 22" fill="none" aria-hidden="true">
											<path
												d="M2.33325 4.78809V17.879M2.33325 4.78809H11.3333H20.3333M2.33325 4.78809L9.30097 10.5794M2.33325 17.879H20.3333M2.33325 17.879L9.30097 10.5794M20.3333 4.78809V17.879M20.3333 4.78809L13.3655 10.5794M9.30097 10.5794L10.2873 11.3992C10.8936 11.9032 11.7729 11.9032 12.3792 11.3992L13.3655 10.5794M20.3333 17.879L13.3655 10.5794"
												stroke="currentColor"
												stroke-linecap="round"
												stroke-linejoin="round"></path>
										</svg>
									</a>
									{
										site.phones.map((phone) => (
											<a href={phone.href} class="contacts_social" aria-label={`Τηλέφωνο ${phone.label}`}>
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 22 22" fill="none" aria-hidden="true">
													<path
														d="M7.2 2.5H4.1c-.9 0-1.6.7-1.6 1.6C2.5 12.4 9.6 19.5 18.4 19.5c.9 0 1.6-.7 1.6-1.6v-3.1c0-.7-.4-1.3-1.1-1.5l-3-1c-.6-.2-1.3 0-1.7.5l-.8 1c-2.3-1.1-4.1-2.9-5.2-5.2l1-.8c.5-.4.7-1.1.5-1.7l-1-3c-.2-.7-.8-1.1-1.5-1.1z"
														stroke="currentColor"
														stroke-linecap="round"
														stroke-linejoin="round"></path>
												</svg>
											</a>
										))
									}
								</div>
							</div>
						</div>

						<div class="grid-col contacts_cell">
							<form
								id="contacts-form"
								name="contacts-form"
								data-form-source="contacts"
								method="post"
								class="cta-form contacts_form"
							>
								<input class="cta-field form-field" maxlength="256" name="firstName" placeholder="Όνομα" type="text" id="c-firstName" />
								<input class="cta-field form-field" maxlength="256" name="lastName" placeholder="Επώνυμο" type="text" id="c-lastName" />
								<input class="cta-field form-field" maxlength="256" name="email" placeholder="Email" type="email" id="c-email" required />
								<input class="cta-field form-field" maxlength="256" name="phone" placeholder="Τηλέφωνο" type="tel" id="c-phone" required />
								<textarea
									placeholder="Μήνυμα — τύπος οχήματος, προτιμώμενο ΙΚΤΕΟ, ημερομηνία"
									maxlength="5000"
									id="c-message"
									name="message"
									class="cta-field form-field cta-field_full"></textarea>
								<input class="form-honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
								<label class="form-consent cta-field_full">
									<input type="checkbox" name="consent" required class="form-consent_box" />
									<span class="form-consent_text text_size-small"
										>Συναινώ στην επεξεργασία των προσωπικών μου δεδομένων από την {site.legalName}
										σύμφωνα με την
										<a href="/privacy-policy/" target="_blank">Πολιτική Απορρήτου</a>.</span
									>
								</label>
								<Button label="Αποστολή" />
								<input type="submit" class="submit-button form-submit" value="Αποστολή" />
							</form>
							<FormFeedback />
						</div>

						{
							branches.map((branch) => (
								<div class="grid-col contacts_cell contacts_address">
									<p class="text_size-medium contacts_company">
										{branch.name}
										{branch.upcoming ? " — σύντομα" : ""}
									</p>
									<p class="text_size-small contacts_address-line">
										{branch.address}
										{branch.postcode ? `, Τ.Κ. ${branch.postcode}` : ""} — {branch.note}
									</p>
									<p class="text_size-small contacts_address-line">{branch.speciality}</p>
									{
										!branch.upcoming && (
											<p class="text_size-small contacts_address-line">
												<a href={branch.maps} target="_blank" rel="noopener noreferrer" class="map-link">
													Οδηγίες →
												</a>
											</p>
										)
									}
								</div>
							))
						}

						<div class="grid-col contacts_cell contacts_address">
							<p class="text_size-medium contacts_company">Ωράριο λειτουργίας</p>
							{
								openingHours.map((slot) => (
									<p class="text_size-small contacts_address-line">
										{slot.days} — {slot.hours}
									</p>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Base>
