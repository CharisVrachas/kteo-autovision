---
/** /company/ — company profile and the timeline from 2002 to today. */
import Base from "../layouts/Base.astro";
import InnerHero from "../components/sections/InnerHero.astro";
import Cta from "../components/sections/Cta.astro";
import BranchStack from "../components/sections/BranchStack.astro";
import ProfileStack from "../components/sections/ProfileStack.astro";
import Journey from "../components/sections/Journey.astro";
import ScrollZoomImage from "../components/sections/ScrollZoomImage.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
import BranchLinkCard from "../components/ui/BranchLinkCard.astro";
import { openBranches } from "../data/site";

const panels = [
	{
		eyebrow: "Ασγούρου",
		title: "7ο χιλ. Ρόδου – Λίνδου",
		text: "Το δεύτερο κέντρο της εταιρείας, σε λειτουργία από τον Σεπτέμβριο του 2009. Από το 2011 ελέγχει και δίκυκλα.",
		image: "/assets/img/rodos/kteo-asgourou.jpg",
		alt: "Το ΙΚΤΕΟ Autovision στα Ασγούρου",
		points: [
			"Σε λειτουργία από τον Σεπτέμβριο του 2009",
			"Διασταύρωση με Νικηφόρου Βρεττάκου",
			"Έλεγχος δικύκλων από τον Μάιο του 2011",
			"Επιβατικά, δίκυκλα, ελαφρά οχήματα",
		],
	},
	{
		eyebrow: "Τσαϊρι",
		title: "1ο χιλ. Τσαϊρι – Αεροδρομίου",
		text: "Το πρώτο ΚΤΕΟ της εταιρείας, σε λειτουργία από τον Οκτώβριο του 2005. Από το 2012 ελέγχει και βαρέα οχήματα.",
		image: "/assets/img/rodos/kteo-exterior.jpg",
		alt: "Το ΙΚΤΕΟ Autovision στο Τσαϊρι",
		points: [
			"Το πρώτο ΚΤΕΟ της εταιρείας, Οκτώβριος 2005",
			"Στον περιφερειακό, όπισθεν του ΤΡΟΦΟΚΑΖΑ",
			"Έλεγχος βαρέων οχημάτων από τον Ιανουάριο του 2012",
			"Επιβατικά, φορτηγά, λεωφορεία",
		],
	},
	{
		eyebrow: "Αφάντου",
		title: "Σύντομα κοντά σας",
		text: "Νέο σημείο τεχνικού ελέγχου ΙΚΤΕΟ Autovision στην περιοχή Αφάντου.",
		image: "/assets/img/rodos/kteo-signage.jpg",
		alt: "Νέο ΙΚΤΕΟ Autovision",
		points: [
			"Νέο σημείο τεχνικού ελέγχου στην περιοχή Αφάντου",
			"Το τρίτο κέντρο της εταιρείας στη Ρόδο",
			"Σύντομα κοντά σας",
		],
	},
];
---

<Base
	title="Εταιρεία — ΙΚΤΕΟ ΔΩΔΕΚΑΝΗΣΟΥ Α.Ε. | Autovision Ρόδου"
	description="Η ΙΚΤΕΟ ΔΩΔΕΚΑΝΗΣΟΥ Α.Ε. ιδρύθηκε το 2002 και λειτουργεί δύο ιδιωτικά ΚΤΕΟ στη Ρόδο, ως μέλος του πανευρωπαϊκού δικτύου AUTOVISION."
	namespace="about"
	pageLabel="Εταιρεία"
	ogImage="/assets/img/rodos/kteo-exterior.jpg"
>
	<InnerHero
		title="ΙΚΤΕΟ <br />ΔΩΔΕΚΑΝΗΣΟΥ Α.Ε."
		lead="Στον τεχνικό έλεγχο οχημάτων στη Ρόδο από το 2002, ως μέλος του πανευρωπαϊκού δικτύου AUTOVISION. Μέλος του πανευρωπαϊκού δικτύου AUTOVISION Contrôle Technique Automobile, της μεγαλύτερης εταιρείας ιδιωτικών ΚΤΕΟ στη Γαλλία."
		narrowLead={false}
	/>

	{/* The photograph opens out from a small tile to full width as you scroll
	    past it. The caption that used to sit over this image is gone — its text
	    now runs under the page title, where it is read rather than passed. */}
	<section data-theme-section="light" class="section_about-kompozit">
		<ScrollZoomImage
			video="/assets/video/company-zoom.mp4"
			image="/assets/video/company-zoom-poster.jpg"
			alt="Το ΙΚΤΕΟ Autovision στη Ρόδο"
		/>
	</section>

	<ProfileStack />

	<BranchStack panels={panels} />

	<Journey
		image="/assets/img/rodos/kteo-exterior.jpg"
		alt="Το ΙΚΤΕΟ Autovision στο Τσαϊρι"
		badge="Από το 2002"
		imageTitle="ΙΚΤΕΟ ΔΩΔΕΚΑΝΗΣΟΥ Α.Ε."
		imageText="Δύο ιδιωτικά ΚΤΕΟ στη Ρόδο, μέλη του πανευρωπαϊκού δικτύου AUTOVISION."
	/>

	<!-- Today -->
	<section data-theme-section="light" class="section_service-cards">
		<div class="container">
			<div class="padding">
				<div class="heading_container">
					<Eyebrow text="σήμερα" />
					<h2 class="heading_h2">Όλες οι κατηγορίες οχημάτων</h2>
					<p class="text_size-medium">
						Με τις δύο μονάδες μας πλέον αδειοδοτημένες για δίκυκλα και για βαρέα οχήματα, η
						εταιρεία παρέχει τεχνικό έλεγχο σε όλες τις κατηγορίες.
					</p>
					<Button label="Κλείστε ραντεβού" href="/online-rantevou/" />
				</div>
			</div>
			<div class="padding is-none">
				<div class="content-grid is-cols-2">
					{
						openBranches.map((branch) => (
							<div class="grid-col">
								<BranchLinkCard branch={branch} />
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<Cta />
</Base>
