---

<section data-theme-section="light" class="section_story section_profile-stack">
	<div class="container">
		<div class="padding is-none is-border-btn-none">
			<div class="orisa-vcards">
				<div class="sec-3-services-details">
					<div class="container section-fix">
						<div class="row">
							{/* Orisa's `h-100` is dropped from this column. It resolves to
							    height: 100% !important, which stretches the column to the full
							    height of the card stack next to it and leaves the text pinned to
							    the top of the screen. Without it the column is its own height and
							    the row's align-items: center puts it in the middle. */}
							<div class="col-lg-5">
								{/* .heading_container, as the other sections use -- it carries the
								    shared measure and padding. This one cannot move out of the
								    Orisa scope the way the journey's did, because it IS the pinned
								    column, so site.css resets the colour and line height it would
								    otherwise inherit from Orisa's lifted base rules. */}
								<div class="heading_container is-width-full">
								<Eyebrow text="το προφίλ μας" />
								{/* Short, like Orisa's own: an h3 and one line under it. The long
								    opening paragraph that used to sit here said the same thing as
								    the first card, at greater length, and filled the column. */}
								<h2 class="heading_h2">Από το 2002 στη Ρόδο</h2>
								<p class="text_size-medium">
Η ιστορία της εταιρείας σε πέντε σταθμούς — από την ίδρυσή της μέχρι τον τεχνικό
έλεγχο όλων των κατηγοριών οχημάτων.
								</p>
								</div>

								{/* Empty in Orisa too: the JS looks for it to confirm the left
								    column is the pinned title, and pins .section-fix around it. */}
								<div class="section-title-pin"></div>
							</div>
							<div class="col-xxl-6 col-lg-7 offset-xxl-1 p-relative">
								<div class="scroll-section vertical-section section scroll-active-item">
									<div class="wrapper">
										<div role="list" class="list">
											{
												companyProfile.map((entry, i) => (
													<div class="item">
														<div class="container bg-neutral-0 rounded-4 border-100 p-relative">
															<div class="rectangular bg-neutral-0 border-100" />
															<div class="row align-items-center py-3">
																<div class="col-12 h-100">
																	<div class="d-flex flex-column p-md-5 p-3 justify-content-between h-100">
																		<div class="icon pb-20">
																			<svg
																				xmlns="http://www.w3.org/2000/svg"
																				width="48"
																				height="48"
																				viewBox="0 0 48 48"
																				fill="none"
																				aria-hidden="true"
																			>
																				<path
																					fill-rule="evenodd"
																					clip-rule="evenodd"
																					d={icons[i % icons.length]}
																					fill="currentColor"
																				/>
																			</svg>
																		</div>
																		<span class="h5 mb-4">{entry.title}</span>
																		<p class="mb-0 fz-font-lg">{entry.text}</p>
																	</div>
																</div>
															</div>
														</div>
													</div>
												))
											}
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
