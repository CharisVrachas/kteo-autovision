---
/**
 * The company profile, as Orisa's "Services details section 3"
 * (services-details.html): a pinned title on the left, and a stack of cards on
 * the right that slide up over one another as you scroll.
 *
 * The markup inside .orisa-vcards is Orisa's own, class for class — Bootstrap
 * grid included. Only the copy is ours. Styles come from
 * assets/css/vendors/orisa-vcards.css, lifted out of Orisa's built CSS and
 * scoped; the pin and the stacking timeline from
 * assets/js/components/orisa-vcards.js, which is its main.js §32 unchanged.
 *
 * The scope class exists for the usual reason: Orisa is Bootstrap-based and
 * claims .container, .row, .item, .wrapper, .h5 — all of which this project's
 * own template already uses for something else.
 *
 * `.section-fix` is what gets pinned, `.section-title-pin` is the marker the
 * JS looks for to know the left column is the title (empty in Orisa too), and
 * the cards are the `.item`s inside `.scroll-section.vertical-section`.
 */
import Eyebrow from "../ui/Eyebrow.astro";
import { companyProfile } from "../../data/site";

/** Orisa's own four card icons from this section, plus its fifth from
    "Home 3 Section 4" — there are five paragraphs and four icons there. */
const icons = [
