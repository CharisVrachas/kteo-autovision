---
/**
 * One card of the portfolio grid, in Orisa's shape: a caption row (title plus a
 * small plus glyph), the thumbnail, and the overlay panel that slides up out of
 * the image on hover.
 *
 * `captionFirst` follows Orisa: its items 1 and 3 carry the caption above the
 * image, item 2 below it.
 */
import type { Branch } from "../../data/site";

interface Props {
	branch: Branch;
	variant?: string;
	captionFirst?: boolean;
}
const { branch, variant = "", captionFirst = true } = Astro.props;

/* The overlay heading is an <h4>, and typography.css uppercases every h4/h5.
   That turns the Greek ordinal in "7ο χιλ." into "7Ο", which reads as seventy.
   CSS cannot reach part of a text node, so the ending is wrapped and excused
   from the transform by .is-ordinal in site.css. */
const ordinal = (text: string) =>
	text.replace(/(\d+)(ος|ου|ης|ο|η)/g, '$1<span class="is-ordinal">$2</span>');

const href = branch.upcoming ? "/contact-us/" : branch.maps;
const external = !branch.upcoming;
const linkAttrs = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<div class={`alt-portfolio-item${variant} mb-30 at-hover-item`}>
	{
		captionFirst && (
			<div class="alt-portfolio-content d-flex justify-content-between align-items-center mb-15">
				<h3 class="h5 alt-portfolio-title mb-0">
					<a href={href} class="common-underline" {...linkAttrs}>
						{branch.area}
					</a>
				</h3>
				<span class="alt-portfolio-plus neutral-950">
					<svg xmlns="http://www.w3.org/2000/svg" width="12" height="11" viewBox="0 0 12 11" fill="none">
						<path d="M4.512 10.8V0H6.984V10.8H4.512ZM0 6.6V4.2H11.52V6.6H0Z" fill="currentColor" />
					</svg>
				</span>
			</div>
		)
	}

	<a
		href={href}
		class={`alt-portfolio-thumb p-relative fix d-block${captionFirst ? "" : " mb-15"}`}
		{...linkAttrs}
	>
		<img
			class="w-100 scale-img-from-to"
			data-value-1="1.5"
			data-value-2="1"
			src={branch.photo}
			alt={branch.name}
		/>
		<div class="alt-portfolio-btn">
			<div class="content">
				<span class="bg-transparent text-uppercase border px-3 py-1 rounded-pill text-white fz-font-label">
					{branch.upcoming ? "σύντομα" : branch.speciality}
				</span>
				<h4 class="h2 fw-400 fz-font-3xl text-white mb-0 mt-20" set:html={ordinal(branch.address)} />
				<p class="text-white fz-font-md mb-0 mt-10 text-truncate-2 des">{branch.note}</p>
			</div>
		</div>
	</a>

	{
		!captionFirst && (
			<div class="alt-portfolio-content d-flex justify-content-between align-items-center">
				<h5 class="alt-portfolio-title mb-0">
					<a href={href} class="common-underline" {...linkAttrs}>
						{branch.area}
					</a>
				</h5>
				<span class="alt-portfolio-plus neutral-950">
					<svg xmlns="http://www.w3.org/2000/svg" width="12" height="11" viewBox="0 0 12 11" fill="none">
						<path d="M4.512 10.8V0H6.984V10.8H4.512ZM0 6.6V4.2H11.52V6.6H0Z" fill="currentColor" />
					</svg>
				</span>
			</div>
		)
	}
</div>
