---
/**
 * Entry-page preloader: the marks, a percentage, and two shape cards that animate
 * while the first page loads. Driven by initPreloader in
 * assets/js/components/preloader.js, which reads the data-preloader-* hooks.
 *
 * Only the homepage uses it — on an inner page there is nothing to cover.
 */
/* The two cards carry the same drawings the homepage does, so the loading screen
   previews the site rather than showing abstract shapes: the vehicle queue under
   "ΤΕΧΝΙΚΟΣ ΕΛΕΓΧΟΣ ΟΧΗΜΑΤΩΝ", Rhodes and its two markers under "ΔΥΟ ΙΚΤΕΟ ΣΤΗΝ
   ΥΠΗΡΕΣΙΑ ΣΑΣ", which is literally what that line says. The marker points and the
   map's proportions match src/pages/index.astro; preloader.js reads them off the
   data attributes, exactly as card-shapes.js does. */
const preloaderVehicles = ["moto", "car", "van"];
const RHODES = { ratio: 0.79, pinScale: 0.2 };
const rhodesPins = [
	[0.68, 0.175],
	[0.9, 0.11],
];
---

<div data-preloader class="preloader" aria-hidden="true">
	<div class="preloader__grid">
		<div class="preloader__cell preloader__orange" data-preloader-orange>
			<div class="preloader__head">
				{/* The mark, not a wordmark. Transparent PNGs, not the navbar's JPGs:
				    the cell is white (preloader.css), so the marks sit straight on it
				    with no plate and no baked-in white ground of their own. */}
				<div class="preloader__logo" data-preloader-logo>
					{/* Both marks share one grid cell (preloader.css) and are matched
					    on height, so nothing shifts as preloader.js cross-fades
					    between them. */}
					<div class="preloader__logo-stack">
						<img
							src="/assets/img/rodos/logo-autovision.png"
							loading="eager"
							alt="AUTOVISION"
							class="preloader__logo-img"
						/>
						<img
							src="/assets/img/rodos/logo-kteo-rodos.png"
							loading="eager"
							alt=""
							aria-hidden="true"
							class="preloader__logo-img"
						/>
					</div>
				</div>
			</div>
		</div>

		<div class="preloader__cell preloader__pattern" data-preloader-pattern>
			<div class="preloader__fill"></div>
			<div class="preloader__progress">
				<span class="preloader__square"></span>
				<span data-preloader-percent class="preloader__percent">0%</span>
			</div>
		</div>

		<div class="preloader__cell preloader__card" data-preloader-card="left">
			<div class="card_head">
				<div class="card_head-left">
					<div class="annotation_container">
						<div class="annotation_dot"></div>
						<div class="annotation_text">
							ΤΕΧΝΙΚΟΣ ΕΛΕΓΧΟΣ ΟΧΗΜΑΤΩΝ<span data-preloader-card-dots="left">...</span>
						</div>
					</div>
				</div>
			</div>
			<div class="card_illustration-wrap is-vehicles" data-preloader-illu="left">
				{preloaderVehicles.map((v, i) => (
					<img
						src={`/assets/img/shapes/vehicle-${v}.svg`}
						loading="eager"
						alt=""
						class={`shape-vehicle is-${i + 1}`}
					/>
				))}
			</div>
		</div>

		<div class="preloader__cell preloader__card" data-preloader-card="right">
			<div class="card_head">
				<div class="card_head-left">
					<div class="annotation_container">
						<div class="annotation_dot"></div>
						<div class="annotation_text">
							ΔΥΟ ΙΚΤΕΟ ΣΤΗΝ ΥΠΗΡΕΣΙΑ ΣΑΣ<span data-preloader-card-dots="right">...</span>
						</div>
					</div>
				</div>
			</div>
			<div
				class="card_illustration-wrap is-map"
				style={`--map-h:10em;--pin-k:${RHODES.pinScale}`}
				data-map-ratio={RHODES.ratio}
				data-pin-scale={RHODES.pinScale}
				data-preloader-illu="right"
			>
				<img src="/assets/img/shapes/map-rhodes.svg" loading="eager" alt="" class="shape-map" />
				{rhodesPins.map(([u, v], i) => (
					<img
						src="/assets/img/shapes/map-pin.svg"
						loading="eager"
						alt=""
						class={`shape-pin is-${i + 1}`}
						data-u={u}
						data-v={v}
					/>
				))}
			</div>
		</div>
	</div>

	{/* Reveal overlay: a copy of the pattern cell that grows from the top right
	    to cover the grid as the preloader lifts. */}
	<div class="preloader__overlay" data-preloader-overlay aria-hidden="true">
		<div class="preloader__overlay-fill"></div>
		<div class="preloader__progress">
			<span class="preloader__square"></span>
			<span data-preloader-overlay-percent class="preloader__percent">0%</span>
		</div>
	</div>
</div>
