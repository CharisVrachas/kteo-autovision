---
/**
 * A labelled <select>. The component set has no select rule, so the styling
 * lives in assets/css/pages/tools.css and mirrors .form-field exactly — same
 * underline, same colours, native arrow replaced with a drawn one so it does
 * not switch to the OS widget on Windows.
 *
 * `required` on a <select> only means anything if nothing valid is selected to
 * begin with. With the first option preselected — which is what a browser does
 * by default — the control is always valid and the attribute is decorative. So
 * a required select gets an empty, disabled placeholder option in front, and
 * the visitor has to make an actual choice.
 */
interface Props {
	name: string;
	label: string;
	options: string[] | { value: string; label: string }[];
	full?: boolean;
	required?: boolean;
	/** Text for the placeholder option on a required select. */
	placeholder?: string;
}
const {
	name,
	label,
	options,
	full = false,
	required = false,
	placeholder = "— Επιλέξτε —",
} = Astro.props;
const items = options.map((o) => (typeof o === "string" ? { value: o, label: o } : o));
---

<label class={`tool_field${full ? " tool_field-full" : ""}`}>
	<span class="text_size-xsmall">{label}</span>
	<select class="tool_select form-field" name={name} id={name} required={required}>
		{required && <option value="" disabled selected>{placeholder}</option>}
		{items.map((o) => <option value={o.value}>{o.label}</option>)}
	</select>
</label>
